# VPS database API (PostgREST)
VIABLE_API_URL=https://s3.viable.fashion/viable-rest
VIABLE_SERVICE_KEY=
AUTH_SECRET=

# Optional direct Postgres for running SQL migrations (VPS / SSH tunnel — not Supabase)
# DATABASE_URL=postgresql://viable_app:PASSWORD@127.0.0.1:5435/viable

# Optional: site URL used in payment callbacks, sitemap, robots
# Production must be the public HTTPS origin (e.g. https://viable.example.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pathao Courier (optional env fallback — prefer Admin → Integrations)
# Always uses production: https://api-hermes.pathao.com
# If a value contains # or = wrap it in double quotes (e.g. PATHAO_PASSWORD="my#pass").
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=

# Optional local-only: PEM for corporate TLS inspection CA (see certs/)
# PATHAO_CA_FILE=certs/your-proxy-root.pem
# PATHAO_TLS_INSECURE=1

# bKash Tokenized Checkout (optional env fallback — prefer Admin → Integrations)
# Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized
# Production: https://tokenized.pay.bka.sh/v1.2.0-beta/tokenized
BKASH_MODE=sandbox
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Nagad Merchant Checkout (optional env fallback — prefer Admin → Integrations)
# Sandbox: http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0
# Production: https://api.mynagad.com
NAGAD_MODE=sandbox
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
# PEM or bare base64 body (use quotes / \n for multiline in env)
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=

# Marketing tags (optional env fallback — prefer Admin → Integrations)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# OMS / Nuport-like outbound webhook (optional env fallback)
OMS_WEBHOOK_URL=
OMS_WEBHOOK_API_KEY=

# Orders → Discord (optional; channel webhook URL from Server Settings → Integrations → Webhooks)
# DISCORD_ORDERS_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Media origin — Viable MinIO on the VPS (not storage.onesigntv.com)
MEDIA_S3_ENDPOINT=https://s3.viable.fashion
MEDIA_PUBLIC_BASE_URL=https://s3.viable.fashion
MEDIA_S3_REGION=us-east-1
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
