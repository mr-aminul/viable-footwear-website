# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: site URL used in auth redirects (local / production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (use Session pooler on IPv4 networks; percent-encode special chars in password)
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DATABASE_DIRECT_URL=

# Pathao Courier (optional env fallback — prefer Admin → Integrations)
# Always uses production: https://api-hermes.pathao.com
# If a value contains # or = wrap it in double quotes (e.g. PATHAO_PASSWORD="my#pass").
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=

# bKash Tokenized Checkout (optional env fallback — prefer Admin → Integrations)
# Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta/tokenized
# Production: https://tokenized.pay.bka.sh/v1.2.0-beta/tokenized
BKASH_MODE=sandbox
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Nagad Merchant Checkout (optional env fallback — prefer Admin → Integrations)
# Sandbox: http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0
# Production: https://api.mynagad.com
NAGAD_MODE=sandbox
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
# PEM or bare base64 body (use quotes / \n for multiline in env)
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PUBLIC_KEY=

# Marketing tags (optional env fallback — prefer Admin → Integrations)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# OMS / Nuport-like outbound webhook (optional env fallback)
OMS_WEBHOOK_URL=
OMS_WEBHOOK_API_KEY=
