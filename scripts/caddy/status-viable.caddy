# Public VPS status page — https://status.viable.fashion
# Installed by scripts/deploy-vps.sh → /etc/caddy/conf.d/status-viable.caddy
#
# Same Next.js process as viable.fashion. Non-asset paths are rewritten to
# /status so the subdomain root shows the insights page.
status.viable.fashion {
	encode gzip zstd

	@nextStatic path /_next/static/*
	header @nextStatic Cache-Control "public, max-age=31536000, immutable"

	# JSON feed + Next assets + icons pass through unchanged.
	@passthrough path /api/status /api/status/* /_next/* /favicon.ico /favicon.png /favicon.svg /apple-touch-icon.png /status /status/*
	handle @passthrough {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		rewrite * /status
		reverse_proxy 127.0.0.1:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}
}
